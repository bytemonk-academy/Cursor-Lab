# TaskFlow back end. Copy to `.env` (it is gitignored) and fill in.

# --- Server -----------------------------------------------------------------
PORT=4000

# Local Mongo (Docker or Homebrew). For Atlas, paste your mongodb+srv:// string.
MONGO_URI=mongodb://localhost:27017/taskflow

# --- Auth (required) --------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# How long a login lasts: 60, "2h", "7d", ...
JWT_EXPIRES_IN=7d

# --- Email (optional) -------------------------------------------------------
# Leave everything below empty and the app still works: email sends fail,
# get logged, and the request succeeds anyway.

# Option A: Gmail with an app password (needs 2-Step Verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: any SMTP server (used when the Gmail values are empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown in the From header (defaults to TaskFlow <GMAIL_USER>)
MAIL_FROM=
